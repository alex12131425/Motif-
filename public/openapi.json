                  "params": {
                    "type": "object",
                    "description": "Parameters for tools/call method",
                    "properties": {
                      "name": {
                        "type": "string",
                        "description": "The name of the tool to execute"
                      },
                      "arguments": {
                        "type": "object",
                        "description": "The arguments for the tool"
                      }
                    }
                  }
                },
                "required": ["method"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful operation"
          }
        }
      }
    }
