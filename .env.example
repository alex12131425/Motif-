# GOOGLE_SHEETS_CREDS: Required for Life Logistics database.
# Must be a valid JSON string of your ENTIRE Google Cloud Service Account credentials file.
# Do not paste just the private key; paste the whole JSON object (project_id, client_email, private_key, etc.)
GOOGLE_SHEETS_CREDS='{"type": "service_account", "project_id": "...", "private_key": "...", "client_email": "..."}'

# OPENWEB_API_KEY: Optional key for price lookups.
OPENWEB_API_KEY="MY_OPENWEB_API_KEY"
